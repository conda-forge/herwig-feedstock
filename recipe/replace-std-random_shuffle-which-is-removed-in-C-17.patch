From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matthew Feickert <matthew.feickert@cern.ch>
Date: Sat, 3 Oct 2026 01:22:35 -0600
Subject: [PATCH] Replace std::random_shuffle which is removed in C++17

std::random_shuffle is deprecated in C++14 and removed in C++17. libc++
does not provide it when compiling as C++17 or later, so the build fails
on macOS with

    error: use of undeclared identifier 'random_shuffle'

Replace the uses with the explicit loop of swaps that the libstdc++
implementation of std::random_shuffle performs, drawing the indices from
UseRandom::irnd as before. The random number sequence, and so the results
of builds that use libstdc++, is unchanged.
---
 Hadronization/ColourReconnector.cc |   18 ++++++++++++------
 PDF/HwRemDecayer.cc                |    6 ++++--
 2 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/Hadronization/ColourReconnector.cc b/Hadronization/ColourReconnector.cc
index dc0e94f..e6660d6 100644
--- a/Hadronization/ColourReconnector.cc
+++ b/Hadronization/ColourReconnector.cc
@@ -233,8 +233,10 @@ void ColourReconnector::_doRecoPlain(ClusterVector & cv) const {
   ClusterVector newcv = cv;
 
   // try to avoid systematic errors by randomising the reconnection order
-  long (*p_irnd)(long) = UseRandom::irnd;
-  random_shuffle( newcv.begin(), newcv.end(), p_irnd );
+  // std::random_shuffle is removed in C++17 and not available in libc++.
+  // This is the same sequence of swaps as the libstdc++ implementation.
+  for ( size_t i = 1; i < newcv.size(); ++i )
+    std::swap(newcv[i], newcv[UseRandom::irnd(i + 1)]);
 
   // iterate over all clusters
   for (CluVecIt cit = newcv.begin(); cit != newcv.end(); cit++) {
@@ -285,8 +287,10 @@ void ColourReconnector::_doRecoBaryonic(ClusterVector & cv) const {
   ClusterVector deleted; deleted.reserve(cv.size());
 
   // try to avoid systematic errors by randomising the reconnection order
-  long (*p_irnd)(long) = UseRandom::irnd;
-  random_shuffle(newcv.begin(), newcv.end(), p_irnd);
+  // std::random_shuffle is removed in C++17 and not available in libc++.
+  // This is the same sequence of swaps as the libstdc++ implementation.
+  for ( size_t i = 1; i < newcv.size(); ++i )
+    std::swap(newcv[i], newcv[UseRandom::irnd(i + 1)]);
 
   // iterate over all clusters
   for (CluVecIt cit = newcv.begin(); cit != newcv.end(); ++cit) {
@@ -422,7 +426,6 @@ void ColourReconnector::_doRecoBaryonicMesonic(ClusterVector & cv) const {
   unsigned number_of_tries = _stepFactor*cv.size()*cv.size();
   if (number_of_tries<1) number_of_tries=1;
 
-  long (*p_irnd)(long) = UseRandom::irnd;
   for (unsigned reconnections_tries = 0; reconnections_tries < number_of_tries; reconnections_tries++) {
     num_meson = 0;
     num_baryon = 0;
@@ -431,7 +434,10 @@ void ColourReconnector::_doRecoBaryonicMesonic(ClusterVector & cv) const {
     bool _found = false;
 
     // Shuffle list of clusters to avoid systematic bias in cluster selection
-    random_shuffle(newcv.begin(), newcv.end(), p_irnd);
+    // std::random_shuffle is removed in C++17 and not available in libc++.
+    // This is the same sequence of swaps as the libstdc++ implementation.
+    for ( size_t i = 1; i < newcv.size(); ++i )
+      std::swap(newcv[i], newcv[UseRandom::irnd(i + 1)]);
 
     // loop over clustervector to find CR candidates
     for (CluVecIt cit = newcv.begin(); cit != newcv.end(); ++cit) {
diff --git a/PDF/HwRemDecayer.cc b/PDF/HwRemDecayer.cc
index 1a775d2..dd2bfc2 100644
--- a/PDF/HwRemDecayer.cc
+++ b/PDF/HwRemDecayer.cc
@@ -1563,8 +1563,10 @@ bool HwRemDecayer::doPhaseSpaceGenerationGluons(vector<Lorentz5Momentum> &softGl
 
     // randomize the mom vector to get the first and the compensating parton 
     // at all possible positions:
-    long (*p_irnd)(long) = UseRandom::irnd;
-    random_shuffle(mom.begin(),mom.end(),p_irnd);
+    // std::random_shuffle is removed in C++17 and not available in libc++.
+    // This is the same sequence of swaps as the libstdc++ implementation.
+    for ( size_t i = 1; i < mom.size(); ++i )
+      std::swap(mom[i], mom[UseRandom::irnd(i + 1)]);
 
 
     for(unsigned int i = 0; i<ncl; i++) xi[i] = randUng(0.6,1.0);
